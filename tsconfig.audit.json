{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "node",
    "jsx": "react-jsx",
    "strict": false,
    "noImplicitAny": false,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/app/*"]
    },
    "typeRoots": ["/data/www/sts/node_modules/@types"]
  },
  "include": ["src/app/**/*.ts", "src/app/**/*.tsx"],
  "exclude": ["node_modules", "dist"]
}
